# Copy to .env for local use. Never commit real credentials.
# Use the credentials of the existing App after linking it.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://example.com
SCOPES=read_customers,write_app_proxy
# Local SQLite session storage; relative paths are resolved from prisma/.
DATABASE_URL=file:./dev.sqlite
# Private model files; must be writable and backed up together with the database.
MODEL_STORAGE_DIR=./data/models

# Images and environment maps share the persistent data volume.
CATALOG_ASSET_DIR=./data/catalog-assets
